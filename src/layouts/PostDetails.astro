      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
    .progress-bar {
      animation:
        grow-progress auto linear both,
        shimmer-progress 4s linear infinite;
      animation-timeline: scroll(y), auto;
      animation-range:
        0% 100%,
