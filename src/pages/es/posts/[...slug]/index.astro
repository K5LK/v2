---
import { type CollectionEntry, getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import Page from "../../../posts/[...slug]/index.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ id, data }) => !data.draft && id.startsWith("es/")
  );
  const sortedPosts = getSortedPosts(posts) as CollectionEntry<"blog">[];
  return posts.map(post => {
    const slug = post.id.replace(/^es\//, "").replace(/\.(md|mdx)$/, "");
    return {
      params: { slug },
      props: { post, sortedPosts },
    };
  });
}

const { post, sortedPosts } = Astro.props;
---

<Page post={post} sortedPosts={sortedPosts} />
