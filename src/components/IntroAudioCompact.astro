---
import type { MetingConfig } from "@/utils/introAudioStore";

/**
 * IntroAudioCompact — A minimized version of the intro/brand audio player.
 * It is meant to be displayed in the header or persistent navigation areas
 * once the user navigates away from the home page.
 */
interface Props {
  src: string;
  label?: string;
  duration?: number;
  isStream?: boolean;
  mode?: "meting";
  meting?: MetingConfig;
  class?: string;
}

const {
  src,
  label = "INTRO",
  duration = 30,
  isStream: streamOverride,
  mode = "meting",
  meting,
  class: className = "",
} = Astro.props;

const initialSrc = src;
const initialLabel = label;
const isStream = streamOverride ?? false;
---

<div
  id="intro-audio-compact"
  class:list={["intro-audio-compact", className]}
  data-src={initialSrc}
  data-label={initialLabel}
  data-duration={String(duration)}
  data-stream={isStream ? "true" : "false"}
  data-mode={mode}
  data-meting={JSON.stringify(meting ?? null)}
  role="region"
  aria-label="Compact audio player"
>
  <button
    id="intro-audio-compact-btn"
    class="intro-audio-compact-btn"
    type="button"
    aria-label="Play audio"
  >
    <svg
      id="intro-audio-compact-play"
      class="intro-audio-compact-icon"
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M3 2.5a.5.5 0 0 1 .765-.424l10 5.5a.5.5 0 0 1 0 .848l-10 5.5A.5.5 0 0 1 3 13.5v-11z"
      ></path>
    </svg>
    <svg
      id="intro-audio-compact-pause"
      class="intro-audio-compact-icon hidden"
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"
      ></path>
    </svg>
  </button>

</div>

<style>
  .intro-audio-compact {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--background) 88%, transparent);
    font-family: var(--font-firacode, monospace);
    font-size: 0.65rem;
    color: var(--foreground);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      border-color 0.22s ease;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 22px -16px
      color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .intro-audio-compact.is-visible {
    display: inline-flex;
    opacity: 1;
    transform: translateY(0);
  }

  .intro-audio-compact.is-playing {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 0 0.8rem color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .intro-audio-compact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      color 0.2s ease;
  }

  .intro-audio-compact-btn:hover {
    transform: scale(1.08);
    color: var(--foreground);
  }

  .intro-audio-compact-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .intro-audio-compact-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .hidden {
    display: none !important;
  }

</style>

<script>
  import {
    getIntroAudioStore,
    emitIntroAudioState,
    loadMetingPlaylist,
    INTRO_AUDIO_STATE_EVENT,
    type IntroAudioState,
    type MetingConfig,
  } from "@/utils/introAudioStore";
  import { soundFx } from "@/utils/soundFx";

  function initIntroAudioCompact() {
    const wrap = document.getElementById(
      "intro-audio-compact"
    ) as HTMLElement | null;
    const btn = document.getElementById(
      "intro-audio-compact-btn"
    ) as HTMLButtonElement | null;
    const iconPlay = document.getElementById(
      "intro-audio-compact-play"
    ) as SVGElement | null;
    const iconPause = document.getElementById(
      "intro-audio-compact-pause"
    ) as SVGElement | null;
    if (!wrap || !btn) return;
    if (wrap.dataset.introAudioCompactInitialized === "true") return;
    wrap.dataset.introAudioCompactInitialized = "true";

    const src = wrap.dataset.src ?? "";
    const label = wrap.dataset.label ?? "INTRO";
    const durationHint = Number(wrap.dataset.duration ?? "0");
    const isStream = wrap.dataset.stream === "true";
    const mode = wrap.dataset.mode === "meting" ? "meting" : undefined;
    const meting = JSON.parse(
      wrap.dataset.meting ?? "null"
    ) as MetingConfig | null;

    const store = getIntroAudioStore({
      src,
      label,
      isStream,
      durationHint,
      mode,
      meting: meting ?? undefined,
    });
    if (mode === "meting" && meting) {
      void loadMetingPlaylist(store, meting);
    }

    const setPlaying = (playing: boolean, stream: boolean) => {
      wrap.classList.toggle("is-playing", playing);
      iconPlay?.classList.toggle("hidden", playing);
      iconPause?.classList.toggle("hidden", !playing);
      btn.setAttribute(
        "aria-label",
        playing
          ? stream
            ? "Pause live audio"
            : "Pause audio"
          : stream
            ? "Resume live audio"
            : "Resume audio"
      );
    };

    const updateVisibility = (state: IntroAudioState) => {
      const isHome =
        window.location.pathname === "/" ||
        window.location.pathname === "/index.html";
      wrap.classList.toggle(
        "is-visible",
        !isHome && (state.playing || state.hasStarted)
      );
    };

    const render = (state: IntroAudioState) => {
      setPlaying(state.playing, state.isStream);
      updateVisibility(state);
    };

    btn.addEventListener("click", () => {
      // Trigger tactile audio feedback on compact player toggle
      soundFx.playTap();
      if (store.audio.paused) {
        void store.audio.play().catch((error: unknown) => {
          // eslint-disable-next-line no-console
          console.error("Audio playback failed for the selected track.", error);
        });
      } else {
        store.audio.pause();
      }
    });
    const controller = new AbortController();

    window.addEventListener(
      INTRO_AUDIO_STATE_EVENT,
      (event: Event) => {
        const customEvent = event as CustomEvent<IntroAudioState>;
        render(customEvent.detail);
      },
      { signal: controller.signal }
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
      },
      { once: true }
    );

    emitIntroAudioState(store);
  }

  initIntroAudioCompact();
  document.addEventListener("astro:page-load", initIntroAudioCompact);
</script>
