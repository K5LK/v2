---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Logo from "@/assets/logo/devosfera.svg";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import { SITE } from "@/config";
import { useTranslations, getTargetLanguageUrl, isActive as checkRouteActive } from "@/i18n/utils";

const { pathname } = Astro.url;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const targetLocale = locale === "es" ? "en" : "es";
const targetLanguageUrl = getTargetLanguageUrl(pathname, targetLocale);
const langToggleTitle =
  locale === "es" ? "Switch to English" : "Cambiar a Español";
const langToggleLabel =
  locale === "es" ? "Switch to English" : "Cambiar a Español";

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => checkRouteActive(currentPath, path);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  {t("nav.skip")}
</a>

<header
  id="main-header"
  class="sticky top-0 z-40 w-full transition-colors duration-300"
>
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative z-30 w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href={locale === "es" ? "/es" : "/"}
          aria-label={locale === "es" ? "Devosfera Inicio" : "Devosfera Home"}
          class="group relative z-20 flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl"
        >
          <Logo class="w-37.5 dark:invert" />
        </a>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex min-w-0 flex-1 justify-center">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav id="nav-menu" class="flex shrink-0 items-center gap-1.5 lg:gap-1">
          <!-- Mobile language switcher chip (visible only on screens < 1024px) -->
          <a
            href={targetLanguageUrl}
            class="nav-lang-chip lg:hidden!"
            title={langToggleTitle}
            aria-label={langToggleLabel}
            data-lang-toggle={targetLocale}
          >
            <svg
              class="nav-lang-chip-icon size-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
              ></path>
            </svg>
            <span class="nav-lang-chip-label">{targetLocale.toUpperCase()}</span
            >
          </a>

          <!-- Mobile search button (visible only on screens < 1024px) -->
          <button
            data-search-trigger
            class="nav-icon-btn lg:hidden!"
            title={locale === "es" ? "Buscar" : "Search"}
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4.5" />
          </button>

          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn lg:hidden"
            aria-label={t("nav.openMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-label-open={t("nav.openMenu")}
            data-label-close={t("nav.closeMenu")}
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on lg+) -->
          <ul class="hidden lg:flex lg:flex-row lg:items-center lg:gap-1">
            <!-- Primary nav: Posts · About -->
            <li>
              <a
                href={locale === "es" ? "/es/posts" : "/posts"}
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
                >{t("nav.posts")}</a
              >
            </li>
            <li>
              <a
                href={locale === "es" ? "/es/about" : "/about"}
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
                >{t("nav.about")}</a
              >
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Search ⌘K -->
            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title={locale === "es" ? "Buscar (⌘K)" : "Search (⌘K)"}
                aria-label={t("nav.openSearch")}
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Language switcher chip -->
            <li class="flex items-center">
              <a
                href={targetLanguageUrl}
                class="nav-lang-chip"
                title={langToggleTitle}
                aria-label={langToggleLabel}
                data-lang-toggle={targetLocale}
              >
                <svg
                  class="nav-lang-chip-icon size-3.5 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
                  ></path>
                </svg>
                <span class="nav-lang-chip-label"
                  >{targetLocale.toUpperCase()}</span
                >
              </a>
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- ··· More button with popover -->
            <li class="more-btn-container relative flex items-center">
              <button
                id="more-btn"
                class="nav-icon-btn relative"
                title={locale === "es" ? "Más opciones" : "More options"}
                aria-label={locale === "es" ? "Más opciones" : "More options"}
                aria-haspopup="true"
                aria-expanded="false"
              >
                <!-- Three dots icon -->
                <svg
                  class="size-4.5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="12" r="1.5"></circle>
                  <circle cx="12" cy="12" r="1.5"></circle>
                  <circle cx="19" cy="12" r="1.5"></circle>
                </svg>
              </button>

              <!-- More Popover -->
              <div
                id="more-popover"
                class="more-popover hidden"
                role="dialog"
                aria-label={locale === "es" ? "Más opciones" : "More options"}
              >
                <!-- Section: Explore -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Explorar" : "Explore"}
                  </p>
                  <div class="popover-links">
                    <a
                      href={locale === "es" ? "/es/tags" : "/tags"}
                      class:list={[
                        "popover-link",
                        { "popover-link-active": isActive("/tags") },
                      ]}
                    >
                      <!-- Tag icon -->
                      <svg
                        class="size-3.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 7h.01M3 7l6 6 6 6 6-6-6-6-6-6-6 6z"></path>
                      </svg>
                      {t("nav.tags")}
                    </a>
                    {
                      SITE.showArchives && (
                        <a
                          href={locale === "es" ? "/es/archives" : "/archives"}
                          class:list={[
                            "popover-link",
                            { "popover-link-active": isActive("/archives") },
                          ]}
                        >
                          <IconArchive class="size-3.5 shrink-0" />
                          {t("nav.archives")}
                        </a>
                      )
                    }
                    {
                      SITE.showGalleries && (
                        <a
                          href={
                            locale === "es" ? "/es/galleries" : "/galleries"
                          }
                          class:list={[
                            "popover-link",
                            { "popover-link-active": isActive("/galleries") },
                          ]}
                        >
                          <IconGallery class="size-3.5 shrink-0" />
                          {t("nav.galleries")}
                        </a>
                      )
                    }
                  </div>
                </div>

                <!-- Divider -->
                <div class="popover-divider" aria-hidden="true"></div>

                <!-- Section: Preferences -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Preferencias" : "Preferences"}
                  </p>
                  <div class="popover-links">
                    <!-- Theme toggle row -->
                    {
                      SITE.lightAndDarkMode && (
                        <div class="popover-row">
                          <div class="popover-row-label">
                            <svg
                              class="size-3.5 shrink-0"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="1.8"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 110 10A5 5 0 0112 7z"
                              />
                            </svg>
                            {locale === "es" ? "Tema" : "Theme"}
                          </div>
                          <button
                            id="theme-btn"
                            class="theme-toggle-pill"
                            title={t("nav.theme")}
                            aria-label="auto"
                            aria-live="polite"
                          >
                            <span class="theme-pill-option block dark:hidden">
                              <IconMoon class="size-3" />
                              {locale === "es" ? "Oscuro" : "Dark"}
                            </span>
                            <span class="theme-pill-option hidden dark:flex">
                              <IconSunHigh class="size-3" />
                              {locale === "es" ? "Claro" : "Light"}
                            </span>
                          </button>
                        </div>
                      )
                    }

                    <!-- Accent color row -->
                    <div class="popover-row popover-row--accent">
                      <div class="popover-row-label">
                        <svg
                          class="size-3.5 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                          ></path>
                        </svg>
                        {t("nav.accentColor")}
                      </div>
                      <div class="accent-swatches">
                        <button
                          data-accent-color="blue"
                          class="accent-swatch bg-[#008fec]"
                          title="Blue"></button>
                        <button
                          data-accent-color="green"
                          class="accent-swatch bg-[#10b981]"
                          title="Green"></button>
                        <button
                          data-accent-color="purple"
                          class="accent-swatch bg-[#a855f7]"
                          title="Purple"></button>
                        <button
                          data-accent-color="amber"
                          class="accent-swatch bg-[#f59e0b]"
                          title="Amber"></button>
                        <button
                          data-accent-color="rose"
                          class="accent-swatch bg-[#f43f5e]"
                          title="Rose"></button>
                      </div>
                    </div>

                    <!-- Sound FX row -->
                    <div class="popover-row popover-row--sound">
                      <div class="popover-row-label">
                        <svg
                          class="size-3.5 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                          <path class="sound-wave-icon" d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                        </svg>
                        {t("nav.soundFx")}
                      </div>
                      <button
                        id="sound-fx-btn"
                        type="button"
                        class="sound-toggle-pill"
                        title={t("nav.soundFxToggle")}
                        aria-label={t("nav.soundFxToggle")}
                        data-label-on={t("nav.soundFxOn")}
                        data-label-off={t("nav.soundFxOff")}
                      >
                        <span id="sound-fx-text" class="sound-pill-text">{t("nav.soundFxOn")}</span>
                      </button>
                    </div>

                    <!-- Sound Profile row -->
                    <div class="popover-row popover-row--profile">
                      <div class="popover-row-label">
                        <svg
                          class="size-3.5 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                        {t("nav.soundProfile")}
                      </div>
                      <button
                        id="sound-profile-btn"
                        type="button"
                        class="sound-toggle-pill"
                        title={t("nav.soundProfile")}
                        aria-label={t("nav.soundProfile")}
                        data-label-mech={t("nav.soundProfileMech")}
                        data-label-scifi={t("nav.soundProfileSciFi")}
                      >
                        <span id="sound-profile-text" class="sound-pill-text">{t("nav.soundProfileMech")}</span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Divider -->
                <div class="popover-divider" aria-hidden="true"></div>

                <!-- Section: Help -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Ayuda" : "Help"}
                  </p>
                  <div class="popover-links">
                    <button
                      class="shortcuts-trigger popover-link w-full text-left"
                      title={locale === "es"
                        ? "Atajos de teclado (?)"
                        : "Keyboard shortcuts (?)"}
                      aria-label={locale === "es"
                        ? "Abrir guía de atajos de teclado"
                        : "Open keyboard shortcuts guide"}
                      aria-keyshortcuts="?"
                    >
                      <svg
                        class="size-3.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <rect x="3" y="5" width="18" height="14" rx="2" ry="2"
                        ></rect>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 9h.01M11 9h.01M15 9h.01M17 9h.01M7 13h.01M11 13h.01M15 13h.01M17 13h.01M9 16h6"
                        ></path>
                      </svg>
                      {t("nav.shortcuts")}
                      <kbd class="nav-kbd ml-auto">?</kbd>
                    </button>
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent opacity-0 transition-opacity duration-300"
  >
  </div>
</header>

<style is:global>
  /* ─── Header Glass & Scroll Physics ─── */
  #main-header {
    background: transparent;
  }

  .header-scrolled {
    background: color-mix(
      in srgb,
      var(--background) 80%,
      transparent
    ) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
  }

  .header-scrolled .header-scrolled-filter {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .nav-intro-audio-compact {
    max-width: 100%;
  }

  /* ─── Logo SVG hover effects ─── */
  .logo-text-left,
  .logo-text-right {
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.4s ease;
  }
  .logo-sphere {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
    transform-origin: 401px 110px;
  }

  #main-header .group:hover .logo-text-left {
    transform: translateX(-5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  #main-header .group:hover .logo-text-right {
    transform: translateX(5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  #main-header .group:hover .logo-sphere {
    filter: drop-shadow(0 0 8px rgba(167, 90, 90, 0.5));
    animation: sphere-wiggle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes sphere-wiggle {
    0% {
      transform: rotate(0deg) scale(1);
    }
    20% {
      transform: rotate(-8deg) scale(1.1);
    }
    40% {
      transform: rotate(5deg) scale(1.15);
    }
    60% {
      transform: rotate(-3deg) scale(1.12);
    }
    80% {
      transform: rotate(1deg) scale(1.05);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }
</style>

<style>
  .nav-logo-text {
    background: linear-gradient(
      135deg,
      var(--foreground) 0%,
      var(--foreground) 60%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ─── Desktop nav links ─── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.5rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link:focus-visible,
  .nav-icon-btn:focus-visible,
  .nav-search-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  :is(.nav-link, .nav-icon-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-active {
    color: var(--accent);
    background: transparent;
  }

  /* Glowing dot for active state (macOS Dock style) */
  .nav-active::after {
    content: "";
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    color: var(--foreground);
  }

  /* ─── Desktop Search Button ─── */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-search-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-kbd {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    color: var(--muted-foreground);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-search-btn:hover .nav-kbd {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  /* ─── Header Language Chip ─── */
  .nav-lang-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted-foreground);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
    user-select: none;
  }

  .nav-lang-chip:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-lang-chip:active {
    transform: scale(0.95);
  }

  .nav-lang-chip:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .nav-lang-chip-icon {
    transition:
      transform 0.25s ease,
      color 0.2s ease;
  }

  .nav-lang-chip:hover .nav-lang-chip-icon {
    transform: scale(1.1);
    color: var(--accent);
  }

  .nav-lang-chip-label {
    font-family: var(--font-firacode, monospace);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  /* ─── More (···) Popover ─── */
  .more-btn-container {
    position: relative;
  }

  /* Active state for more button when popover is open */
  #more-btn[aria-expanded="true"] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  /*
   * FIX OVAL: after a mouse click, browsers set :focus on the button which
   * triggers :focus-visible in some engines (e.g. Chrome >=86 heuristics).
   * Suppress focus-visible styling on #more-btn entirely — it's a pure
   * pointer-driven control and doesn't need a keyboard focus ring.
   */
  #more-btn:focus-visible {
    outline: none;
    box-shadow: none;
  }

  /*
   * FIX LAG: backdrop-filter is on a ::before pseudo-element isolated from
   * the content layer. This prevents hover repaints inside the popover from
   * forcing the GPU to recalculate the blur on every frame.
   */
  .more-popover {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: 220px;
    border-radius: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    /* Use an opaque-enough background so content is legible without blur */
    background: color-mix(in srgb, var(--background) 96%, transparent);
    box-shadow:
      0 20px 40px -8px rgba(0, 0, 0, 0.12),
      0 8px 16px -4px rgba(0, 0, 0, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    padding: 0.5rem;
    z-index: 50;
    /* FIX OVAL: never show a focus ring on the dialog container */
    outline: none;
    /* Isolate stacking context so child focus rings stay inside */
    isolation: isolate;
    /* Entrance animation */
    transform-origin: top right;
    animation: popover-in 0.18s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Blur lives here — completely isolated from hover/paint of children */
  .more-popover::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    z-index: -1;
    pointer-events: none;
  }

  .more-popover.hidden {
    display: none;
  }

  @keyframes popover-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(-4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .popover-section {
    padding: 0.25rem 0;
  }

  .popover-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 35%, transparent);
    padding: 0.25rem 0.625rem 0.375rem;
    font-family: var(--font-firacode, monospace);
    user-select: none;
  }

  .popover-links {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .popover-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.5rem;
    /* FIX LAG: promote to own composite layer for instant hover response */
    transform: translateZ(0);
    transition:
      color 0.12s ease,
      background-color 0.12s ease;
    cursor: pointer;
    border: none;
    background: transparent;
    text-decoration: none;
  }

  .popover-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .popover-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    outline-offset: -2px;
  }

  .popover-link-active {
    color: var(--accent);
  }

  .popover-divider {
    margin: 0.375rem 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 40%, transparent),
      transparent
    );
  }

  /* ─── Preference rows (theme, lang, accent) ─── */
  .popover-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
  }

  .popover-row-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    user-select: none;
  }

  /* Theme pill toggle */
  .theme-toggle-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    background: color-mix(in srgb, var(--muted) 50%, transparent);
    color: var(--foreground);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
    gap: 0.3rem;
  }

  .theme-toggle-pill:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .theme-pill-option {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* Sound FX pill toggle */
  .sound-toggle-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    background: color-mix(in srgb, var(--muted) 50%, transparent);
    color: var(--foreground);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
    gap: 0.3rem;
  }

  .sound-toggle-pill:hover,
  .sound-toggle-pill.active {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .sound-toggle-pill.muted {
    opacity: 0.65;
    border-color: color-mix(in srgb, var(--border) 30%, transparent);
  }

  /* Accent swatches inside popover */
  .popover-row--accent {
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.375rem;
  }

  .accent-swatches {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .accent-swatch {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--border) 30%, transparent);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    padding: 0;
  }

  .accent-swatch:hover {
    transform: scale(1.2);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--background) 100%, transparent),
      0 0 0 3.5px color-mix(in srgb, var(--foreground) 30%, transparent);
  }

  .accent-swatch:focus-visible {
    outline: none;
    transform: scale(1.2);
    box-shadow:
      0 0 0 2px var(--background),
      0 0 0 4px var(--accent);
  }

  /* Active accent swatch styling */
  html[data-accent="blue"] [data-accent-color="blue"],
  html[data-accent="green"] [data-accent-color="green"],
  html[data-accent="purple"] [data-accent-color="purple"],
  html[data-accent="amber"] [data-accent-color="amber"],
  html[data-accent="rose"] [data-accent-color="rose"] {
    transform: scale(1.15);
    box-shadow:
      0 0 0 2px var(--background),
      0 0 0 3.5px var(--accent);
  }

  /* ─── Animated Hamburger Button ─── */
  .hamburger-btn {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    transition:
      background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-line--1 {
    top: 0;
  }
  .hamburger-line--2 {
    top: 6px;
  }
  .hamburger-line--3 {
    top: 12px;
    width: 60%;
  }

  /* Open state: morph to X */
  .hamburger-btn[aria-expanded="true"] .hamburger-line {
    background: var(--accent);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--3 {
    top: 6px;
    width: 100%;
    transform: rotate(-45deg);
  }
</style>

<script>
  let headerCleanup: AbortController | null = null;
  let scrollCleanup: AbortController | null = null;

  function setupScrollPhysics() {
    if (scrollCleanup) scrollCleanup.abort();
    scrollCleanup = new AbortController();
    const { signal } = scrollCleanup;

    const header = document.getElementById("main-header");
    const navWrap = document.getElementById("top-nav-wrap");
    const borderLine = document.getElementById("header-border");

    if (!header || !navWrap || !borderLine) return;

    let rafPending = false;
    const handleScroll = () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 15;
        header.classList.toggle("header-scrolled", scrolled);
        navWrap.classList.toggle("sm:py-5", !scrolled);
        navWrap.classList.toggle("sm:py-3", scrolled);
        borderLine.classList.toggle("opacity-0", !scrolled);
        borderLine.classList.toggle("opacity-100", scrolled);
        rafPending = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll(); // Init instantly
  }

  function setupMobileNav() {
    if (headerCleanup) headerCleanup.abort();
    headerCleanup = new AbortController();
    const { signal } = headerCleanup;

    const menuBtn = document.querySelector("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const backdrop = document.querySelector(".mobile-menu-backdrop");

    if (!menuBtn || !mobileMenu) return;

    const labelOpen = menuBtn.getAttribute("data-label-open") || "Open Menu";
    const labelClose = menuBtn.getAttribute("data-label-close") || "Close Menu";

    const closeMenu = () => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", labelOpen);
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
    };

    menuBtn.addEventListener(
      "click",
      () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          closeMenu();
        } else {
          menuBtn.setAttribute("aria-expanded", "true");
          menuBtn.setAttribute("aria-label", labelClose);
          mobileMenu.classList.add("is-open");
          mobileMenu.setAttribute("aria-hidden", "false");
        }
      },
      { signal }
    );

    if (backdrop) {
      backdrop.addEventListener("click", closeMenu, { signal });
    }

    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu, { signal });
    });
  }

  let moreCleanup: AbortController | null = null;

  function setupMorePopover() {
    if (moreCleanup) moreCleanup.abort();
    moreCleanup = new AbortController();
    const { signal } = moreCleanup;

    const moreBtn = document.getElementById("more-btn");
    const morePopover = document.getElementById("more-popover");

    if (!moreBtn || !morePopover) return;

    const openPopover = () => {
      moreBtn.setAttribute("aria-expanded", "true");
      morePopover.classList.remove("hidden");
    };

    const closePopover = () => {
      moreBtn.setAttribute("aria-expanded", "false");
      morePopover.classList.add("hidden");
    };

    moreBtn.addEventListener(
      "click",
      e => {
        e.stopPropagation();
        const isExpanded = moreBtn.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closePopover();
        } else {
          openPopover();
        }
      },
      { signal }
    );

    // Close when clicking outside
    document.addEventListener(
      "click",
      e => {
        const target = e.target as HTMLElement;
        if (
          !morePopover.classList.contains("hidden") &&
          !morePopover.contains(target) &&
          target !== moreBtn &&
          !moreBtn.contains(target)
        ) {
          closePopover();
        }
      },
      { signal }
    );

    // Close popover on Escape key
    document.addEventListener(
      "keydown",
      e => {
        if (e.key === "Escape" && !morePopover.classList.contains("hidden")) {
          closePopover();
          moreBtn.focus();
        }
      },
      { signal }
    );

    // Close popover on scroll
    window.addEventListener("scroll", closePopover, { passive: true, signal });

    // Close popover when focus leaves the container
    morePopover.addEventListener(
      "focusout",
      e => {
        const relatedTarget = e.relatedTarget as HTMLElement;
        if (
          relatedTarget &&
          !morePopover.contains(relatedTarget) &&
          relatedTarget !== moreBtn
        ) {
          closePopover();
        }
      },
      { signal }
    );

    // Close popover when a link inside is clicked
    morePopover.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closePopover, { signal });
    });
  }

  import { soundFx } from "@/utils/soundFx";

  let accentCleanup: AbortController | null = null;

  /**
   * Initializes accent color picker buttons across desktop and mobile menus,
   * triggering chromatic audio feedback (playPop) when a color swatch is selected.
   */
  function setupAccentPicker() {
    if (accentCleanup) accentCleanup.abort();
    accentCleanup = new AbortController();
    const { signal } = accentCleanup;

    // Accent selection logic (desktop and mobile picker buttons)
    document.querySelectorAll("[data-accent-color]").forEach(btn => {
      btn.addEventListener(
        "click",
        () => {
          const color = btn.getAttribute("data-accent-color");
          if (color) {
            document.documentElement.setAttribute("data-accent", color);
            localStorage.setItem("theme-accent", color);
            soundFx.playPop(color);
          }
        },
        { signal }
      );
    });
  }

  let soundFxCleanup: AbortController | null = null;

  /**
   * Sets up Sound FX (Mute/Unmute) and Sound Profile (Mechanical/Sci-Fi) toggles,
   * synchronizing UI labels, active pill states, and reactive custom events across components.
   */
  function setupSoundFxToggle() {
    if (soundFxCleanup) soundFxCleanup.abort();
    soundFxCleanup = new AbortController();
    const { signal } = soundFxCleanup;

    const soundBtn = document.getElementById("sound-fx-btn");
    const soundText = document.getElementById("sound-fx-text");
    const soundBtnMobile = document.getElementById("sound-fx-btn-mobile");
    const soundLabelMobile = document.getElementById("sound-fx-label-mobile");

    const profileBtn = document.getElementById("sound-profile-btn");
    const profileText = document.getElementById("sound-profile-text");
    const profileBtnMobile = document.getElementById("sound-profile-btn-mobile");
    const profileLabelMobile = document.getElementById("sound-profile-label-mobile");

    const labelOn = soundBtn?.getAttribute("data-label-on") || "On";
    const labelOff = soundBtn?.getAttribute("data-label-off") || "Muted";
    const labelMech = profileBtn?.getAttribute("data-label-mech") || "Mechanical";
    const labelSciFi = profileBtn?.getAttribute("data-label-scifi") || "Sci-Fi";

    function updateUi(enabled: boolean) {
      if (soundText) soundText.textContent = enabled ? labelOn : labelOff;
      if (soundBtn) {
        soundBtn.classList.toggle("active", enabled);
        soundBtn.classList.toggle("muted", !enabled);
      }
      if (soundLabelMobile) {
        soundLabelMobile.textContent = enabled ? labelOn : labelOff;
      }
      if (soundBtnMobile) {
        soundBtnMobile.classList.toggle("active", enabled);
        soundBtnMobile.classList.toggle("muted", !enabled);
      }
    }

    function updateProfileUi(profile: "mechanical" | "scifi") {
      const label = profile === "scifi" ? labelSciFi : labelMech;
      if (profileText) profileText.textContent = label;
      if (profileLabelMobile) profileLabelMobile.textContent = label;
    }

    // Initial state reflection
    updateUi(soundFx.isEnabled());
    updateProfileUi(soundFx.getProfile());

    // Listen for toggle clicks
    if (soundBtn) {
      soundBtn.addEventListener(
        "click",
        () => {
          const newState = soundFx.toggle();
          updateUi(newState);
        },
        { signal }
      );
    }

    if (soundBtnMobile) {
      soundBtnMobile.addEventListener(
        "click",
        () => {
          const newState = soundFx.toggle();
          updateUi(newState);
        },
        { signal }
      );
    }

    if (profileBtn) {
      profileBtn.addEventListener(
        "click",
        () => {
          const next = soundFx.cycleProfile();
          updateProfileUi(next);
        },
        { signal }
      );
    }

    if (profileBtnMobile) {
      profileBtnMobile.addEventListener(
        "click",
        () => {
          const next = soundFx.cycleProfile();
          updateProfileUi(next);
        },
        { signal }
      );
    }

    // Listen for cross-component sound state changes
    window.addEventListener(
      "soundfx:change",
      ((e: CustomEvent<{ enabled: boolean }>) => {
        updateUi(e.detail.enabled);
      }) as EventListener,
      { signal }
    );

    window.addEventListener(
      "soundprofile:change",
      ((e: CustomEvent<{ profile: "mechanical" | "scifi" }>) => {
        updateProfileUi(e.detail.profile);
      }) as EventListener,
      { signal }
    );
  }

  // Initial load
  setupScrollPhysics();
  setupMobileNav();
  setupMorePopover();
  setupAccentPicker();
  setupSoundFxToggle();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupScrollPhysics();
    setupMobileNav();
    setupMorePopover();
    setupAccentPicker();
    setupSoundFxToggle();
  });
</script>
