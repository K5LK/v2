---
/**
 * Header.astro
 *
 * Sticky navigation header with blurred scroll filter, navigation popover,
 * responsive mobile menu, compact audio player, and modular subcomponents.
 *
 * Modularized: Styles live in src/styles/header.css, client logic in src/scripts/header.ts,
 * and preference controls in HeaderAccentPicker.astro & HeaderSoundToggle.astro.
 */
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Logo from "@/assets/logo/devosfera.svg";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import HeaderAccentPicker from "./HeaderAccentPicker.astro";
import HeaderSoundToggle from "./HeaderSoundToggle.astro";
import { SITE } from "@/config";
import { useTranslations, getTargetLanguageUrl, isActive as checkRouteActive } from "@/i18n/utils";
import "@/styles/header.css";

const { pathname } = Astro.url;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const targetLocale = locale === "es" ? "en" : "es";
const targetLanguageUrl = getTargetLanguageUrl(pathname, targetLocale);
const langToggleTitle =
  locale === "es" ? "Switch to English" : "Cambiar a Español";
const langToggleLabel =
  locale === "es" ? "Switch to English" : "Cambiar a Español";

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => checkRouteActive(currentPath, path);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  {t("nav.skip")}
</a>

<header
  id="main-header"
  class="sticky top-0 z-40 w-full transition-colors duration-300"
>
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative z-30 w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href={locale === "es" ? "/es" : "/"}
          aria-label={locale === "es" ? "Devosfera Inicio" : "Devosfera Home"}
          class="group relative z-20 flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl"
        >
          <Logo class="w-37.5 dark:invert" />
        </a>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex min-w-0 flex-1 justify-center">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav id="nav-menu" class="flex shrink-0 items-center gap-1.5 lg:gap-1">
          <!-- Mobile language switcher chip (visible only on screens < 1024px) -->
          <a
            href={targetLanguageUrl}
            class="nav-lang-chip lg:hidden!"
            title={langToggleTitle}
            aria-label={langToggleLabel}
            data-lang-toggle={targetLocale}
          >
            <svg
              class="nav-lang-chip-icon size-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
              ></path>
            </svg>
            <span class="nav-lang-chip-label">{targetLocale.toUpperCase()}</span
            >
          </a>

          <!-- Mobile search button (visible only on screens < 1024px) -->
          <button
            data-search-trigger
            class="nav-icon-btn lg:hidden!"
            title={locale === "es" ? "Buscar" : "Search"}
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4.5" />
          </button>

          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn lg:hidden"
            aria-label={t("nav.openMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-label-open={t("nav.openMenu")}
            data-label-close={t("nav.closeMenu")}
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on lg+) -->
          <ul class="hidden lg:flex lg:flex-row lg:items-center lg:gap-1">
            <!-- Primary nav: Posts · About -->
            <li>
              <a
                href={locale === "es" ? "/es/posts" : "/posts"}
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
                >{t("nav.posts")}</a
              >
            </li>
            <li>
              <a
                href={locale === "es" ? "/es/about" : "/about"}
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
                >{t("nav.about")}</a
              >
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Search ⌘K -->
            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title={locale === "es" ? "Buscar (⌘K)" : "Search (⌘K)"}
                aria-label={t("nav.openSearch")}
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- Language switcher chip -->
            <li class="flex items-center">
              <a
                href={targetLanguageUrl}
                class="nav-lang-chip"
                title={langToggleTitle}
                aria-label={langToggleLabel}
                data-lang-toggle={targetLocale}
              >
                <svg
                  class="nav-lang-chip-icon size-3.5 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
                  ></path>
                </svg>
                <span class="nav-lang-chip-label"
                  >{targetLocale.toUpperCase()}</span
                >
              </a>
            </li>

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <!-- ··· More button with popover -->
            <li class="more-btn-container relative flex items-center">
              <button
                id="more-btn"
                class="nav-icon-btn relative"
                title={locale === "es" ? "Más opciones" : "More options"}
                aria-label={locale === "es" ? "Más opciones" : "More options"}
                aria-haspopup="true"
                aria-expanded="false"
              >
                <!-- Three dots icon -->
                <svg
                  class="size-4.5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="12" r="1.5"></circle>
                  <circle cx="12" cy="12" r="1.5"></circle>
                  <circle cx="19" cy="12" r="1.5"></circle>
                </svg>
              </button>

              <!-- More Popover -->
              <div
                id="more-popover"
                class="more-popover hidden"
                role="dialog"
                aria-label={locale === "es" ? "Más opciones" : "More options"}
              >
                <!-- Section: Explore -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Explorar" : "Explore"}
                  </p>
                  <div class="popover-links">
                    <a
                      href={locale === "es" ? "/es/tags" : "/tags"}
                      class:list={[
                        "popover-link",
                        { "popover-link-active": isActive("/tags") },
                      ]}
                    >
                      <!-- Tag icon -->
                      <svg
                        class="size-3.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 7h.01M3 7l6 6 6 6 6-6-6-6-6-6-6 6z"></path>
                      </svg>
                      {t("nav.tags")}
                    </a>
                    {
                      SITE.showArchives && (
                        <a
                          href={locale === "es" ? "/es/archives" : "/archives"}
                          class:list={[
                            "popover-link",
                            { "popover-link-active": isActive("/archives") },
                          ]}
                        >
                          <IconArchive class="size-3.5 shrink-0" />
                          {t("nav.archives")}
                        </a>
                      )
                    }
                    {
                      SITE.showGalleries && (
                        <a
                          href={
                            locale === "es" ? "/es/galleries" : "/galleries"
                          }
                          class:list={[
                            "popover-link",
                            { "popover-link-active": isActive("/galleries") },
                          ]}
                        >
                          <IconGallery class="size-3.5 shrink-0" />
                          {t("nav.galleries")}
                        </a>
                      )
                    }
                  </div>
                </div>

                <!-- Divider -->
                <div class="popover-divider" aria-hidden="true"></div>

                <!-- Section: Preferences -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Preferencias" : "Preferences"}
                  </p>
                  <div class="popover-links">
                    <!-- Theme toggle row -->
                    {
                      SITE.lightAndDarkMode && (
                        <div class="popover-row">
                          <div class="popover-row-label">
                            <svg
                              class="size-3.5 shrink-0"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="1.8"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 110 10A5 5 0 0112 7z"
                              />
                            </svg>
                            {locale === "es" ? "Tema" : "Theme"}
                          </div>
                          <button
                            id="theme-btn"
                            class="theme-toggle-pill"
                            title={t("nav.theme")}
                            aria-label="auto"
                            aria-live="polite"
                          >
                            <span class="theme-pill-option block dark:hidden">
                              <IconMoon class="size-3" />
                              {locale === "es" ? "Oscuro" : "Dark"}
                            </span>
                            <span class="theme-pill-option hidden dark:flex">
                              <IconSunHigh class="size-3" />
                              {locale === "es" ? "Claro" : "Light"}
                            </span>
                          </button>
                        </div>
                      )
                    }

                    <!-- Accent color picker subcomponent -->
                    <HeaderAccentPicker />

                    <!-- Sound FX toggle subcomponent -->
                    <HeaderSoundToggle />
                  </div>
                </div>

                <!-- Divider -->
                <div class="popover-divider" aria-hidden="true"></div>

                <!-- Section: Help -->
                <div class="popover-section">
                  <p class="popover-section-label">
                    {locale === "es" ? "Ayuda" : "Help"}
                  </p>
                  <div class="popover-links">
                    <button
                      class="shortcuts-trigger popover-link w-full text-left"
                      title={locale === "es"
                        ? "Atajos de teclado (?)"
                        : "Keyboard shortcuts (?)"}
                      aria-label={locale === "es"
                        ? "Abrir guía de atajos de teclado"
                        : "Open keyboard shortcuts guide"}
                      aria-keyshortcuts="?"
                    >
                      <svg
                        class="size-3.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      {locale === "es" ? "Atajos" : "Shortcuts"}
                      <kbd class="nav-kbd ml-auto">?</kbd>
                    </button>
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent opacity-0 transition-opacity duration-300"
  >
  </div>
</header>

<script>
  import { initHeader } from "@/scripts/header";

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
