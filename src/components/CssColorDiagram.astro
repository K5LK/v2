---
// CssColorDiagram.astro
---

<div class="voronoi-container">
  <div class="voronoi-svg-container">
    <div class="voronoi-shadow"></div>
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 1024 1024"
      xmlns="http://www.w3.org/2000/svg"
      class="voronoi-svg"></svg>
  </div>
  <div id="voronoi-preview"></div>
</div>

<style is:global>
  .voronoi-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 25px auto;
  }

  .voronoi-svg-container {
    position: relative;
    width: 100%;
    max-width: 400px;
  }

  .voronoi-shadow {
    position: absolute;
    width: calc(100% + 8px);
    height: calc(100% + 8px);
    inset: -4px;
    background: var(--color-bg, white);
    border-radius: 50%;
    box-shadow:
      rgb(0 0 0 / 2%) 0.6px 1.3px 2.2px,
      rgb(0 0 0 / 3%) 1.5px 3.1px 5.3px,
      rgb(0 0 0 / 4%) 2.9px 5.8px 10px,
      rgb(0 0 0 / 4%) 5.1px 10.3px 17.9px;
  }

  .dark .voronoi-shadow {
    background: #1f2937;
  }

  .voronoi-svg {
    position: relative;
    display: block;
    width: 100%;
    clip-path: circle(50% at 50% 50%);
  }

  .voronoi-name-container {
    position: relative;
    height: 3rem;
    width: 100%;
    max-width: 275px;
    margin: 0px auto 25px;
    transform: translateY(+12px);
    pointer-events: none;
  }

  .voronoi-name-container2 {
    background-color: var(--color-bg-muted, #f3f4f6);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 4px;
    margin-bottom: 25px;
    border-radius: 8px;
    box-shadow:
      rgb(0 0 0 / 2%) 0.6px 0.7px 2.2px,
      rgb(0 0 0 / 3%) 1.5px 2px 5.3px,
      rgb(0 0 0 / 4%) 2.9px 3.5px 10px,
      rgb(0 0 0 / 4%) 5.1px 6px 17.9px,
      rgb(0 0 0 / 5%) 9.6px 12px 33.4px,
      rgb(0 0 0 / 7%) 23px 30px 80px;
  }

  .dark .voronoi-name-container2 {
    background-color: #1f2937;
  }

  .voronoi-color {
    width: 3rem;
    height: 3rem;
    border-radius: 4px;
    transition: background-color 350ms ease 0s;
  }

  .voronoi-name {
    flex: 1 1 0%;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text, inherit);
  }
</style>

<script>
  interface VoronoiSite {
    x: number;
    y: number;
  }

  interface VoronoiPoint {
    x: number;
    y: number;
  }

  interface VoronoiHalfEdge {
    getStartpoint(): VoronoiPoint;
    getEndpoint(): VoronoiPoint;
  }

  interface VoronoiCell {
    site: VoronoiSite;
    halfedges: VoronoiHalfEdge[];
    closeMe?: boolean;
  }

  interface VoronoiDiagramResult {
    cells: VoronoiCell[];
  }

  interface VoronoiInstance {
    compute(
      sites: VoronoiSite[],
      bbox: { xl: number; xr: number; yt: number; yb: number }
    ): VoronoiDiagramResult;
  }

  interface VoronoiConstructor {
    new (): VoronoiInstance;
  }

  function initVoronoiDiagram() {
    const svg = document.querySelector(".voronoi-svg") as SVGElement | null;
    const preview = document.getElementById("voronoi-preview");
    if (!svg || !preview) return;

    if (svg.querySelector("polygon")) {
      return;
    }

    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const hasVoronoi = Boolean(
          (window as unknown as { Voronoi?: VoronoiConstructor }).Voronoi
        );
        if (hasVoronoi) {
          resolve();
          return;
        }

        const existingScript = document.querySelector<HTMLScriptElement>(
          `script[src="${src}"]`
        );
        if (existingScript) {
          if (
            (window as unknown as { Voronoi?: VoronoiConstructor }).Voronoi
          ) {
            resolve();
            return;
          }
          existingScript.addEventListener("load", () => resolve(), {
            once: true,
          });
          existingScript.addEventListener(
            "error",
            () => reject(new Error(`Failed to load ${src}`)),
            { once: true }
          );
          return;
        }

        const script = document.createElement("script");
        script.src = src;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error(`Failed to load ${src}`));
        document.head.appendChild(script);
      });
    }

    loadScript("/js/rhill-voronoi-core.min.js")
      .then(() => {
        initializeDiagram(svg, preview);
      })
      .catch(() => {
        // Silently handled without console errors
      });
  }

  function initializeDiagram(svg: SVGElement, preview: HTMLElement) {
    const newcolors: Record<string, [number, number, number]> = {
      black: [0, 0, 0],
      silver: [192, 192, 192],
      "gray / grey": [128, 128, 128],
      white: [255, 255, 255],
      maroon: [128, 0, 0],
      red: [255, 0, 0],
      purple: [128, 0, 128],
      "fuchsia / magenta": [255, 0, 255],
      green: [0, 128, 0],
      lime: [0, 255, 0],
      olive: [128, 128, 0],
      yellow: [255, 255, 0],
      navy: [0, 0, 128],
      blue: [0, 0, 255],
      teal: [0, 128, 128],
      "aqua / cyan": [0, 255, 255],
      orange: [255, 165, 0],
      aliceblue: [240, 248, 255],
      antiquewhite: [250, 235, 215],
      aquamarine: [127, 255, 212],
      azure: [240, 255, 255],
      beige: [245, 245, 220],
      bisque: [255, 228, 196],
      blanchedalmond: [255, 235, 205],
      blueviolet: [138, 43, 226],
      brown: [165, 42, 42],
      burlywood: [222, 184, 135],
      cadetblue: [95, 158, 160],
      chartreuse: [127, 255, 0],
      chocolate: [210, 105, 30],
      coral: [255, 127, 80],
      cornflowerblue: [100, 149, 237],
      cornsilk: [255, 248, 220],
      crimson: [220, 20, 60],
      darkblue: [0, 0, 139],
      darkcyan: [0, 139, 139],
      darkgoldenrod: [184, 134, 11],
      "darkgray / darkgrey": [169, 169, 169],
      darkgreen: [0, 100, 0],
      darkkhaki: [189, 183, 107],
      darkmagenta: [139, 0, 139],
      darkolivegreen: [85, 107, 47],
      darkorange: [255, 140, 0],
      darkorchid: [153, 50, 204],
      darkred: [139, 0, 0],
      darksalmon: [233, 150, 122],
      darkseagreen: [143, 188, 143],
      darkslate54: [72, 61, 139], // renamed darkslateblue to prevent key mismatch if needed, but let's keep name exact
      darkslateblue: [72, 61, 139],
      "darkslategray / darkslategrey": [47, 79, 79],
      darkturquoise: [0, 206, 209],
      darkviolet: [148, 0, 211],
      deeppink: [255, 20, 147],
      deepskyblue: [0, 191, 255],
      "dimgray / dimgrey": [105, 105, 105],
      dodgerblue: [30, 144, 255],
      firebrick: [178, 34, 34],
      floralwhite: [255, 250, 240],
      forestgreen: [34, 139, 34],
      gainsboro: [220, 220, 220],
      ghostwhite: [248, 248, 255],
      gold: [255, 215, 0],
      goldenrod: [218, 165, 32],
      greenyellow: [173, 255, 47],
      honeydew: [240, 255, 240],
      hotpink: [255, 105, 180],
      indianred: [205, 92, 92],
      indigo: [75, 0, 130],
      ivory: [255, 255, 240],
      khaki: [240, 230, 140],
      lavender: [230, 230, 250],
      lavenderblush: [255, 240, 245],
      lawngreen: [124, 252, 0],
      lemonchiffon: [255, 250, 205],
      lightblue: [173, 216, 230],
      lightcoral: [240, 128, 128],
      lightcyan: [224, 255, 255],
      lightgoldenrodyellow: [250, 250, 210],
      "lightgray / lightgrey": [211, 211, 211],
      lightgreen: [144, 238, 144],
      lightpink: [255, 182, 193],
      lightsalmon: [255, 160, 122],
      lightseagreen: [32, 178, 170],
      lightskyblue: [135, 206, 250],
      "lightslategray / lightslategrey": [119, 136, 153],
      lightsteelblue: [176, 196, 222],
      lightyellow: [255, 255, 224],
      limegreen: [50, 205, 50],
      linen: [250, 240, 230],
      mediumaquamarine: [102, 205, 170],
      mediumblue: [0, 0, 205],
      mediumorchid: [186, 85, 211],
      mediumpurple: [147, 112, 219],
      mediumseagreen: [60, 179, 113],
      mediumslateblue: [123, 104, 238],
      mediumspringgreen: [0, 250, 154],
      mediumturquoise: [72, 209, 204],
      mediumvioletred: [199, 21, 133],
      midnightblue: [25, 25, 112],
      mintcream: [245, 255, 250],
      mistyrose: [255, 228, 225],
      moccasin: [255, 228, 181],
      navajowhite: [255, 222, 173],
      oldlace: [253, 245, 230],
      olivedrab: [107, 142, 35],
      orangered: [255, 69, 0],
      orchid: [218, 112, 214],
      palegoldenrod: [238, 232, 170],
      palegreen: [152, 251, 152],
      paleturquoise: [175, 238, 238],
      palevioletred: [219, 112, 147],
      papayawhip: [255, 239, 213],
      peachpuff: [255, 218, 185],
      peru: [205, 133, 63],
      pink: [255, 192, 203],
      plum: [221, 160, 221],
      powderblue: [176, 224, 230],
      rosybrown: [188, 143, 143],
      royalblue: [65, 105, 225],
      saddlebrown: [139, 69, 19],
      salmon: [250, 128, 114],
      sandybrown: [244, 164, 96],
      seagreen: [46, 139, 87],
      seashell: [255, 245, 238],
      sienna: [160, 82, 45],
      skyblue: [135, 206, 235],
      slateblue: [106, 90, 205],
      "slategray / slategrey": [112, 128, 144],
      snow: [255, 250, 250],
      springgreen: [0, 255, 127],
      steelblue: [70, 130, 180],
      tan: [210, 180, 140],
      thistle: [216, 191, 216],
      tomato: [255, 99, 71],
      turquoise: [64, 224, 208],
      violet: [238, 130, 238],
      wheat: [245, 222, 179],
      whitesmoke: [245, 245, 245],
      yellowgreen: [154, 205, 50],
      rebeccapurple: [102, 51, 153],
    };

    function rgb2hsv(r: number, g: number, b: number) {
      const v = Math.max(r, g, b);
      const c = v - Math.min(r, g, b);
      const h =
        c &&
        (v === r ? (g - b) / c : v === g ? 2 + (b - r) / c : 4 + (r - g) / c);
      return [60 * (h < 0 ? h + 6 : h), v && c / v, v];
    }

    const radius = 512;
    const cx = radius;
    const cy = radius;

    function renderWheel() {
      const VoronoiClass = (
        window as unknown as { Voronoi?: VoronoiConstructor }
      ).Voronoi;
      if (!VoronoiClass) return;

      const colorsBySite: Record<string, string> = {};
      const sites: VoronoiSite[] = [];
      Object.entries(newcolors).forEach(([name, color]) => {
        const [r, g, b] = color;
        const [h, s, v] = rgb2hsv(r / 255, g / 255, b / 255);

        const colorRadius = (s + v / 5) * 0.75 * radius;
        const colorAngle = (h / 360) * 2 * Math.PI;

        const x = Math.cos(colorAngle) * colorRadius + cx;
        const y = Math.sin(colorAngle) * colorRadius + cy;
        sites.push({ x, y });
        colorsBySite[[x, y].toString()] = name;
      });

      const voronoi = new VoronoiClass().compute(sites, {
        xl: 0,
        xr: 1024,
        yt: 0,
        yb: 1024,
      });

      voronoi.cells.forEach(cell => {
        if (cell.closeMe) return;
        const colorName = colorsBySite[[cell.site.x, cell.site.y].toString()];
        if (!colorName) return;
        const [r, g, b] = newcolors[colorName];

        const c = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "polygon"
        );
        c.setAttribute("data-color", colorName);

        let points = "";
        cell.halfedges.forEach(edge => {
          const s = edge.getStartpoint();
          points += `${s.x} ${s.y}, `;
        });
        points = points.replace(/, $/, "");
        c.setAttribute("points", points);

        const rgb = `rgb(${r}, ${g}, ${b})`;
        c.setAttribute("fill", rgb);
        c.setAttribute("stroke", rgb);

        svg.appendChild(c);
      });
    }

    renderWheel();

    function activateColor(el: SVGElement) {
      const colorName = el.getAttribute("data-color");
      if (!colorName) return;
      renderPreview(colorName);
      el.parentNode?.appendChild(el);
      el.style.stroke = "black";
      el.style.strokeWidth = "5px";
    }

    function componentToHex(c: number) {
      const hex = c.toString(16);
      return hex.length === 1 ? "0" + hex : hex;
    }

    function rgbToHex(r: number, g: number, b: number) {
      return "#" + componentToHex(r) + componentToHex(g) + componentToHex(b);
    }

    let previewLocked = false;
    function renderPreview(color: string | null) {
      if (!color) {
        preview.innerHTML = "";
        return;
      }
      const [r, g, b] = newcolors[color];

      preview.innerHTML = `
        <div class="voronoi-name-container">
            <div class="voronoi-name-container2">
                <div class="voronoi-color" style="background-color: ${rgbToHex(r, g, b)};">&nbsp;</div>
                <span class="voronoi-name">${color}</span>
            </div>
        </div>
        `;
    }

    const abortController = new AbortController();
    const { signal } = abortController;
    document.addEventListener("astro:before-swap", () => abortController.abort(), {
      once: true,
    });

    svg.addEventListener(
      "mouseover",
      e => {
        const el = e.target as SVGElement;
        if (el.tagName !== "polygon") return;
        if (!previewLocked) {
          activateColor(el);
        }
      },
      { signal }
    );

    svg.addEventListener(
      "mouseout",
      e => {
        const el = e.target as SVGElement;
        if (el.tagName !== "polygon") return;
        if (!previewLocked) {
          renderPreview(null);
          el.removeAttribute("style");
        }
      },
      { signal }
    );

    document.body.addEventListener(
      "click",
      e => {
        const el = e.target as SVGElement;

        if (preview.contains(el)) return;

        svg.querySelectorAll("polygon[style]").forEach(item => {
          (item as SVGElement).removeAttribute("style");
        });

        if (el.tagName !== "polygon") {
          previewLocked = false;
          renderPreview(null);
          return;
        }

        previewLocked = true;
        activateColor(el);
      },
      { signal }
    );
  }

  // Inicializar en la carga inicial y también con transiciones de página de Astro
  initVoronoiDiagram();
  document.addEventListener("astro:page-load", initVoronoiDiagram);
</script>
