---
/**
 * HeroTerminalPrompt.astro
 *
 * Interactive CLI / Shell Terminal console embedded in the Hero section.
 * Evolves the static terminal badge (`~ /open-terminal $`) into an interactive Easter Egg shell.
 *
 * Modularized: Styles live in src/styles/hero-terminal.css and client logic in src/scripts/hero-terminal.ts.
 * Memory Optimization: Completely releases Matrix rain canvas framebuffer memory when closed.
 */
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/utils";
import "@/styles/hero-terminal.css";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const { prefix, path, suffix } = SITE.heroTerminalPrompt;
---

<div class:list={["hero-terminal-wrapper relative inline-block", className]}>
  <!-- Terminal Prompt Trigger Badge (Highly Interactive & Clearly Clickable) -->
  <button
    id="hero-terminal-trigger"
    type="button"
    class="terminal-trigger-btn group relative inline-flex items-center gap-2.5 rounded-full border border-border/50 bg-muted/25 px-3.5 py-1.5 font-sans text-xs sm:text-sm font-medium transition-all duration-300 hover:border-accent/60 hover:bg-accent/15 hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 active:scale-95 text-foreground cursor-pointer select-none ring-1 ring-border/20 hover:ring-accent/40"
    style="font-stretch: 115%;"
    title={t("terminal.badgeHint")}
    aria-label={t("terminal.badgeHint")}
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <!-- Glowing pulse aura on hover -->
    <span
      class="pointer-events-none absolute -inset-0.5 -z-10 rounded-full bg-linear-to-r from-accent/25 via-accent/10 to-transparent opacity-0 blur-xs transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    ></span>

    <!-- Terminal Code Glyph Icon -->
    <span class="flex size-4 shrink-0 items-center justify-center text-accent transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 17 10 11 4 5"></polyline>
        <line x1="12" y1="19" x2="20" y2="19"></line>
      </svg>
    </span>

    <!-- Prompt text -->
    <div class="flex items-center gap-1 font-firacode tracking-tight">
      <span class="text-accent font-bold">{prefix}</span>
      <span class="text-foreground/90 font-medium">{path}</span>
      <span class="opacity-40">{suffix}</span>
      <!-- Terminal blinking cursor -->
      <span class="terminal-cursor text-accent font-firacode font-bold text-xs animate-pulse" aria-hidden="true">_</span>
    </div>

    <!-- Keyboard Shortcut / Interactive Key Indicator -->
    <span
      class="inline-flex items-center justify-center rounded-md bg-accent/15 border border-accent/30 px-1.5 py-0.5 font-firacode text-[10px] font-bold text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-background group-hover:border-accent shadow-xs"
      title={t("terminal.badgeKeyHint")}
    >
      <kbd class="font-firacode font-bold">C</kbd>
    </span>
  </button>

  <!-- Floating Micro-Terminal Modal Overlay -->
  <div
    id="hero-terminal-modal"
    class="terminal-modal-overlay hidden fixed inset-0 z-50 items-center justify-center p-3 sm:p-4"
    role="dialog"
    aria-modal="true"
    aria-label={t("terminal.title")}
  >
    <!-- Backdrop Blur -->
    <div
      id="terminal-backdrop"
      class="terminal-backdrop absolute inset-0 bg-background/80 backdrop-blur-md transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <!-- Terminal Window Container -->
    <div
      id="terminal-card"
      class="terminal-card relative z-10 flex flex-col w-full max-w-xl max-h-[85vh] overflow-hidden rounded-2xl border border-border/50 bg-background/95 text-foreground p-0 shadow-2xl backdrop-blur-xl transition-all duration-300 font-firacode"
    >
      <!-- Terminal Header / Titlebar -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-border/30 bg-muted/20 select-none">
        <div class="flex items-center gap-2">
          <!-- Mac-style Traffic Light Buttons -->
          <button
            id="terminal-close-btn"
            type="button"
            class="flex size-3 rounded-full bg-[#ff5f56] border border-[#e0443e] transition-transform hover:scale-110 active:scale-95"
            title={t("terminal.helpExit")}
            aria-label={t("terminal.helpExit")}
          ></button>
          <button
            id="terminal-clear-btn"
            type="button"
            class="flex size-3 rounded-full bg-[#ffbd2e] border border-[#dea123] transition-transform hover:scale-110 active:scale-95"
            title={t("terminal.helpClear")}
            aria-label={t("terminal.helpClear")}
          ></button>
          <span
            class="flex size-3 rounded-full bg-[#27c93f] border border-[#1aab29] opacity-70"
            aria-hidden="true"
          ></span>
        </div>

        <div class="flex items-center gap-1.5 text-xs text-foreground/70 font-semibold tracking-wide">
          <svg class="size-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>{t("terminal.title")}</span>
        </div>

        <div class="flex items-center gap-1">
          <kbd class="text-[10px] text-foreground/50 border border-border/30 bg-muted/20 px-1.5 py-0.5 rounded">ESC</kbd>
        </div>
      </div>

      <!-- Terminal Output Screen -->
      <div
        id="terminal-output"
        class="terminal-output flex-1 overflow-y-auto p-4 space-y-2.5 text-xs sm:text-sm leading-relaxed text-foreground/85 scrollbar-thin"
        tabindex="0"
        aria-live="polite"
      >
        <!-- Welcome banner -->
        <div class="text-accent/90 font-bold">
          ⚡ {t("terminal.welcome")}
        </div>
      </div>

      <!-- Quick Command Suggestions Chips -->
      <div class="px-4 py-2 border-t border-border/20 bg-muted/10 flex flex-wrap items-center gap-1.5 select-none">
        <span class="text-[10px] text-foreground/45 uppercase tracking-wider font-bold mr-1">Quick:</span>
        <button type="button" class="term-chip" data-cmd="help"><span class="opacity-70">&gt;_</span> help</button>
        <button type="button" class="term-chip" data-cmd="neofetch"><span>🖥️</span> neofetch</button>
        <button type="button" class="term-chip" data-cmd="matrix"><span>🕶️</span> matrix</button>
        <button type="button" class="term-chip" data-cmd="random"><span>🎲</span> random</button>
        <button type="button" class="term-chip" data-cmd="quote"><span>💬</span> quote</button>
        <button type="button" class="term-chip" data-cmd="theme"><span>🎨</span> theme</button>
        <button type="button" class="term-chip" data-cmd="ping"><span>📡</span> ping</button>
        <button type="button" class="term-chip" data-cmd="cat"><span>🐱</span> cat</button>
        <button type="button" class="term-chip" data-cmd="audio"><span>🎵</span> audio</button>
        <button type="button" class="term-chip" data-cmd="clear"><span>🧹</span> clear</button>
      </div>

      <!-- Interactive Command Input Line -->
      <form id="terminal-form" class="flex items-center gap-2 p-3 border-t border-border/30 bg-muted/20">
        <span class="text-accent font-bold shrink-0 text-xs sm:text-sm select-none">
          guest@devosfera:~$
        </span>
        <input
          id="terminal-input"
          type="text"
          class="flex-1 bg-transparent text-foreground placeholder:text-foreground/35 outline-none border-none text-xs sm:text-sm font-firacode"
          placeholder={t("terminal.promptPlaceholder")}
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-accent/15 border border-accent/30 p-1.5 text-accent hover:bg-accent/25 transition-colors"
          aria-label="Execute command"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 10 4 15 9 20"></polyline>
            <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Full-Screen Matrix Digital Rain Canvas -->
  <canvas
    id="matrix-rain-canvas"
    class="pointer-events-none fixed inset-0 z-45 transition-opacity duration-700 opacity-0 hidden"
  ></canvas>
</div>

<script>
  import { initHeroTerminal } from "@/scripts/hero-terminal";

  initHeroTerminal();
  document.addEventListener("astro:page-load", initHeroTerminal);
</script>
