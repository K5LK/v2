---
/**
 * HeroTerminalPrompt.astro
 *
 * Interactive CLI / Shell Terminal console embedded in the Hero section.
 * Evolves the static terminal badge (`~ /open-terminal $`) into an interactive Easter Egg shell.
 *
 * Key Capabilities:
 * - Trigger Badge: Interactive button with glow aura, ping animation, code glyph, and `<kbd>C</kbd>` shortcut pill.
 * - Floating Terminal Window: macOS-style traffic light dots (🔴 close, 🟡 clear), quick command chips, and UNIX prompt.
 * - Interactive Command Engine:
 *   - `matrix`: Full-screen canvas Matrix digital code rain animation (4.5s duration, auto-cleanup).
 *   - `random` / `roll`: Dispatches the "Surprise Me" roulette modal directly from the command line.
 *   - `ping [target]`: Real-time ICMP ping simulator with latency, TTL, and transmission stats.
 *   - `cat [file]`: ASCII cat dialogue, `.env` quantum vault easter egg, and hidden flag discovery.
 *   - `cowsay [msg]`: ASCII cow dialogue speech bubble generator.
 *   - `neofetch` / `fastfetch`: Distro / blog system specs, uptime, active theme, and tech stack summary.
 *   - `theme` / `color`: Cycles through active accent color palettes dynamically.
 *   - `quote` / `tip`: Random curated dev quotes in English and Spanish.
 *   - `audio` / `lofi`: Toggles background Lo-Fi stream audio playback.
 *   - `whoami` / `about`: Author bio and project links.
 *   - `clear` / `exit`: Terminal screen clearing and modal dismissal.
 * - Keyboard Shortcuts:
 *   - `C` / `c`: Opens terminal shell (strictly on homepage, ignores editable inputs & modifiers).
 *   - `ESC`: Closes the terminal modal.
 *   - `ArrowUp` / `ArrowDown`: Navigates previously executed command history.
 * - Web Audio API:
 *   - Synthesizes mechanical keypress clicks on input typing and dual-tone execution chime.
 */
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const { prefix, path, suffix } = SITE.heroTerminalPrompt;
---

<div class:list={["hero-terminal-wrapper relative inline-block", className]}>
  <!-- Terminal Prompt Trigger Badge (Highly Interactive & Clearly Clickable) -->
  <button
    id="hero-terminal-trigger"
    type="button"
    class="terminal-trigger-btn group relative inline-flex items-center gap-2.5 rounded-full border border-border/50 bg-muted/25 px-3.5 py-1.5 font-sans text-xs sm:text-sm font-medium transition-all duration-300 hover:border-accent/60 hover:bg-accent/15 hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 active:scale-95 text-foreground cursor-pointer select-none ring-1 ring-border/20 hover:ring-accent/40"
    style="font-stretch: 115%;"
    title={t("terminal.badgeHint")}
    aria-label={t("terminal.badgeHint")}
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <!-- Glowing pulse aura on hover -->
    <span
      class="pointer-events-none absolute -inset-0.5 -z-10 rounded-full bg-linear-to-r from-accent/25 via-accent/10 to-transparent opacity-0 blur-xs transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    ></span>

    <!-- Terminal Code Glyph Icon -->
    <span class="flex size-4 shrink-0 items-center justify-center text-accent transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 17 10 11 4 5"></polyline>
        <line x1="12" y1="19" x2="20" y2="19"></line>
      </svg>
    </span>

    <!-- Status Ping dot -->
    <span class="relative flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
      ></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
    </span>

    <!-- Prompt text -->
    <div class="flex items-center gap-1 font-firacode tracking-tight">
      <span class="text-accent font-bold">{prefix}</span>
      <span class="text-foreground/90 font-medium">{path}</span>
      <span class="opacity-40">{suffix}</span>
      <!-- Terminal blinking cursor -->
      <span class="terminal-cursor text-accent font-firacode font-bold text-xs animate-pulse" aria-hidden="true">_</span>
    </div>

    <!-- Keyboard Shortcut / Interactive Key Indicator -->
    <span
      class="inline-flex items-center justify-center rounded-md bg-accent/15 border border-accent/30 px-1.5 py-0.5 font-firacode text-[10px] font-bold text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-background group-hover:border-accent shadow-xs"
      title={t("terminal.badgeKeyHint")}
    >
      <kbd class="font-firacode font-bold">C</kbd>
    </span>
  </button>

  <!-- Floating Micro-Terminal Modal Overlay -->
  <div
    id="hero-terminal-modal"
    class="terminal-modal-overlay hidden fixed inset-0 z-50 items-center justify-center p-3 sm:p-4"
    role="dialog"
    aria-modal="true"
    aria-label={t("terminal.title")}
  >
    <!-- Backdrop Blur -->
    <div
      id="terminal-backdrop"
      class="terminal-backdrop absolute inset-0 bg-background/80 backdrop-blur-md transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <!-- Terminal Window Container -->
    <div
      id="terminal-card"
      class="terminal-card relative z-10 flex flex-col w-full max-w-xl max-h-[85vh] overflow-hidden rounded-2xl border border-border/50 bg-background/95 text-foreground p-0 shadow-2xl backdrop-blur-xl transition-all duration-300 font-firacode"
    >
      <!-- Terminal Header / Titlebar -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-border/30 bg-muted/20 select-none">
        <div class="flex items-center gap-2">
          <!-- Mac-style Traffic Light Buttons -->
          <button
            id="terminal-close-btn"
            type="button"
            class="flex size-3 rounded-full bg-[#ff5f56] border border-[#e0443e] transition-transform hover:scale-110 active:scale-95"
            title={t("terminal.helpExit")}
            aria-label={t("terminal.helpExit")}
          ></button>
          <button
            id="terminal-clear-btn"
            type="button"
            class="flex size-3 rounded-full bg-[#ffbd2e] border border-[#dea123] transition-transform hover:scale-110 active:scale-95"
            title={t("terminal.helpClear")}
            aria-label={t("terminal.helpClear")}
          ></button>
          <span
            class="flex size-3 rounded-full bg-[#27c93f] border border-[#1aab29] opacity-70"
            aria-hidden="true"
          ></span>
        </div>

        <div class="flex items-center gap-1.5 text-xs text-foreground/70 font-semibold tracking-wide">
          <svg class="size-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>{t("terminal.title")}</span>
        </div>

        <div class="flex items-center gap-1">
          <kbd class="text-[10px] text-foreground/50 border border-border/30 bg-muted/20 px-1.5 py-0.5 rounded">ESC</kbd>
        </div>
      </div>

      <!-- Terminal Output Screen -->
      <div
        id="terminal-output"
        class="terminal-output flex-1 overflow-y-auto p-4 space-y-2.5 text-xs sm:text-sm leading-relaxed text-foreground/85 scrollbar-thin"
        tabindex="0"
        aria-live="polite"
      >
        <!-- Welcome banner -->
        <div class="text-accent/90 font-bold">
          ⚡ {t("terminal.welcome")}
        </div>
      </div>

      <!-- Quick Command Suggestions Chips -->
      <div class="px-4 py-2 border-t border-border/20 bg-muted/10 flex flex-wrap items-center gap-1.5 select-none">
        <span class="text-[10px] text-foreground/45 uppercase tracking-wider font-bold mr-1">Quick:</span>
        <button type="button" class="term-chip" data-cmd="help"><span class="opacity-70">&gt;_</span> help</button>
        <button type="button" class="term-chip" data-cmd="neofetch"><span>🖥️</span> neofetch</button>
        <button type="button" class="term-chip" data-cmd="matrix"><span>🕶️</span> matrix</button>
        <button type="button" class="term-chip" data-cmd="random"><span>🎲</span> random</button>
        <button type="button" class="term-chip" data-cmd="quote"><span>💬</span> quote</button>
        <button type="button" class="term-chip" data-cmd="theme"><span>🎨</span> theme</button>
        <button type="button" class="term-chip" data-cmd="ping"><span>📡</span> ping</button>
        <button type="button" class="term-chip" data-cmd="cat"><span>🐱</span> cat</button>
        <button type="button" class="term-chip" data-cmd="audio"><span>🎵</span> audio</button>
        <button type="button" class="term-chip" data-cmd="clear"><span>🧹</span> clear</button>
      </div>

      <!-- Interactive Command Input Line -->
      <form id="terminal-form" class="flex items-center gap-2 p-3 border-t border-border/30 bg-muted/20">
        <span class="text-accent font-bold shrink-0 text-xs sm:text-sm select-none">
          guest@devosfera:~$
        </span>
        <input
          id="terminal-input"
          type="text"
          class="flex-1 bg-transparent text-foreground placeholder:text-foreground/35 outline-none border-none text-xs sm:text-sm font-firacode"
          placeholder={t("terminal.promptPlaceholder")}
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-accent/15 border border-accent/30 p-1.5 text-accent hover:bg-accent/25 transition-colors"
          aria-label="Execute command"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 10 4 15 9 20"></polyline>
            <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Full-Screen Matrix Digital Rain Canvas -->
  <canvas
    id="matrix-rain-canvas"
    class="pointer-events-none fixed inset-0 z-45 transition-opacity duration-700 opacity-0 hidden"
  ></canvas>
</div>

<style>
  .terminal-modal-overlay {
    display: flex;
    animation: terminal-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .terminal-modal-overlay.hidden {
    display: none !important;
  }

  @keyframes terminal-pop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .terminal-output {
    max-height: 280px;
    min-height: 180px;
  }

  .terminal-card {
    background: color-mix(in srgb, var(--background) 96%, transparent);
    color: var(--foreground);
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    box-shadow:
      0 20px 50px -10px color-mix(in srgb, var(--foreground) 10%, transparent),
      0 0 25px -5px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  /* Light mode terminal card polish */
  :global(html[data-theme="light"]) .terminal-card {
    background: rgba(255, 255, 255, 0.97);
    border-color: rgba(203, 213, 225, 0.85);
    box-shadow:
      0 20px 45px -10px rgba(15, 23, 42, 0.14),
      0 4px 12px rgba(15, 23, 42, 0.05);
  }

  .term-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    font-family: var(--font-firacode, monospace);
    font-weight: 600;
    color: var(--foreground);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 0.5rem;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .term-chip:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .term-chip:active {
    transform: scale(0.95);
  }

  /* High-contrast semantic terminal output styles for light & dark themes */
  :global(.term-line) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.term-prompt-echo) {
    color: var(--accent);
    font-weight: 700;
  }

  :global(.term-res-success) {
    color: #16a34a; /* high-contrast emerald in light mode */
  }
  :global(html[data-theme="dark"] .term-res-success) {
    color: #4ade80; /* bright green in dark mode */
  }

  :global(.term-res-info) {
    color: #0284c7; /* deep sky blue in light mode */
  }
  :global(html[data-theme="dark"] .term-res-info) {
    color: #38bdf8; /* bright cyan in dark mode */
  }

  :global(.term-res-warn) {
    color: #d97706; /* amber in light mode */
  }
  :global(html[data-theme="dark"] .term-res-warn) {
    color: #fbbf24; /* bright amber in dark mode */
  }

  :global(.term-res-error) {
    color: #dc2626; /* red in light mode */
  }
  :global(html[data-theme="dark"] .term-res-error) {
    color: #f87171; /* bright red in dark mode */
  }

  :global(.term-res-quote) {
    color: #9333ea;
    font-style: italic;
    border-left: 2px solid #9333ea;
    padding-left: 0.5rem;
    margin: 0.25rem 0;
  }
  :global(html[data-theme="dark"] .term-res-quote) {
    color: #e879f9;
    border-left-color: #e879f9;
  }

  :global(.term-cyan-text) {
    color: #0284c7;
    font-weight: 700;
  }
  :global(html[data-theme="dark"] .term-cyan-text) {
    color: #38bdf8;
    font-weight: 700;
  }

  :global(.term-green-text) {
    color: #16a34a;
  }
  :global(html[data-theme="dark"] .term-green-text) {
    color: #4ade80;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  // Quotes collection in English and Spanish
  const DEV_QUOTES = {
    en: [
      "“Simplicity is prerequisite for reliability.” — Edsger W. Dijkstra",
      "“Make it work, make it right, make it fast.” — Kent Beck",
      "“Programs must be written for people to read, and only incidentally for machines to execute.” — Abelson & Sussman",
      "“There are only two hard things in Computer Science: cache invalidation and naming things.” — Phil Karlton",
      "“First, solve the problem. Then, write the code.” — John Johnson",
      "“Any fool can write code that a computer can understand. Good programmers write code that humans can understand.” — Martin Fowler",
      "“Code is like humor. When you have to explain it, it’s bad.” — Cory House",
      "“Experience is the name everyone gives to their mistakes.” — Oscar Wilde",
    ],
    es: [
      "«La simplicidad es prerrequisito para la confiabilidad.» — Edsger W. Dijkstra",
      "«Haz que funcione, hazlo bien, hazlo rápido.» — Kent Beck",
      "«El código debe escribirse para que las personas lo lean, y sólo incidentalmente para que las máquinas lo ejecuten.» — Abelson & Sussman",
      "«Solo hay dos cosas difíciles en Ciencias de la Computación: invalidar caché y nombrar variables.» — Phil Karlton",
      "«Primero, resuelve el problema. Luego, escribe el código.» — John Johnson",
      "«Cualquiera puede escribir código que una máquina entienda. Los buenos programadores escriben código que los humanos entienden.» — Martin Fowler",
      "«El código es como el humor. Si tienes que explicarlo, es malo.» — Cory House",
      "«La experiencia es el nombre que todos dan a sus errores.» — Oscar Wilde",
    ],
  };

  const ACCENTS = ["blue", "green", "purple", "amber", "rose"] as const;

  // Full-Screen Matrix Rain Canvas Animation
  let matrixAnimationId: number | null = null;
  let matrixTimeoutId: number | null = null;

  function runMatrixRain() {
    const canvas = document.getElementById("matrix-rain-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    if (matrixAnimationId) cancelAnimationFrame(matrixAnimationId);
    if (matrixTimeoutId) clearTimeout(matrixTimeoutId);

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.classList.remove("hidden");
    canvas.style.opacity = "1";

    const characters = "0123456789ABCDEFｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜDEVOSFERA_ASTRO_REACT_RUST_PYTHON";
    const fontSize = 16;
    const columns = Math.floor(canvas.width / fontSize);
    const drops: number[] = Array.from({ length: columns }).fill(1) as number[];

    const isDark = document.documentElement.getAttribute("data-theme") !== "light";
    const bgFade = isDark ? "rgba(10, 15, 25, 0.08)" : "rgba(255, 255, 255, 0.14)";
    const textColor = isDark ? "#00ff66" : "#059669";

    function draw() {
      if (!ctx || !canvas) return;
      ctx.fillStyle = bgFade;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = textColor;
      ctx.font = `${fontSize}px monospace`;

      for (let i = 0; i < drops.length; i++) {
        const text = characters.charAt(Math.floor(Math.random() * characters.length));
        ctx.fillText(text, i * fontSize, (drops[i] ?? 0) * fontSize);

        if ((drops[i] ?? 0) * fontSize > canvas.height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        if (drops[i] !== undefined) drops[i]++;
      }

      matrixAnimationId = requestAnimationFrame(draw);
    }

    draw();

    // Auto-fadeout after 4.5 seconds
    matrixTimeoutId = window.setTimeout(() => {
      canvas.style.opacity = "0";
      setTimeout(() => {
        if (matrixAnimationId) cancelAnimationFrame(matrixAnimationId);
        canvas.classList.add("hidden");
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }, 700);
    }, 4500);
  }

  function initHeroTerminal() {
    const trigger = document.getElementById("hero-terminal-trigger") as HTMLButtonElement | null;
    const modal = document.getElementById("hero-terminal-modal") as HTMLElement | null;
    const backdrop = document.getElementById("terminal-backdrop") as HTMLElement | null;
    const closeBtn = document.getElementById("terminal-close-btn") as HTMLButtonElement | null;
    const clearBtn = document.getElementById("terminal-clear-btn") as HTMLButtonElement | null;
    const form = document.getElementById("terminal-form") as HTMLFormElement | null;
    const input = document.getElementById("terminal-input") as HTMLInputElement | null;
    const output = document.getElementById("terminal-output") as HTMLElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>(".term-chip");

    if (!trigger || !modal || !input || !output) return;

    const commandHistory: string[] = [];
    let historyIndex = -1;

    const isEs = document.documentElement.lang === "es";

    function appendOutput(content: string, typeClass = "") {
      if (!output) return;
      const line = document.createElement("div");
      line.className = `term-line ${typeClass}`;
      line.innerHTML = content;
      output.appendChild(line);
      output.scrollTop = output.scrollHeight;
    }

    function openTerminal() {
      modal?.classList.remove("hidden");
      trigger?.setAttribute("aria-expanded", "true");
      setTimeout(() => input?.focus(), 80);
    }

    function closeTerminal() {
      modal?.classList.add("hidden");
      trigger?.setAttribute("aria-expanded", "false");
    }

    function clearOutput() {
      if (!output) return;
      output.innerHTML = `<div class="text-accent/90 font-bold">⚡ ${isEs ? "Consola limpiada. Escribe 'help' para ver comandos." : "Console cleared. Type 'help' to see commands."}</div>`;
    }

    function executeCommand(rawCmd: string) {
      const trimmed = rawCmd.trim();
      if (!trimmed) return;

      const parts = trimmed.split(" ");
      const cmd = (parts[0] || "").toLowerCase();
      const args = parts.slice(1).join(" ").trim();

      soundFx.playExecute();

      // Echo command line
      appendOutput(`<span class="term-prompt-echo">guest@devosfera:~$ ${trimmed}</span>`);

      commandHistory.unshift(trimmed);
      historyIndex = -1;

      switch (cmd) {
        case "help":
          appendOutput(`
            <div class="space-y-1">
              <div class="text-accent font-bold">${isEs ? "Comandos disponibles:" : "Available commands:"}</div>
              <div><span class="term-cyan-text">matrix</span>    - ${isEs ? "Lluvia de código Matrix digital (4.5s)" : "Trigger Matrix digital rain stream"}</div>
              <div><span class="term-cyan-text">random</span>    - ${isEs ? "Lanza la ruleta de artículos aleatorios" : "Pick a random post with roulette"}</div>
              <div><span class="term-cyan-text">quote</span>     - ${isEs ? "Muestra una frase/consejo dev al azar" : "Display a witty dev quote"}</div>
              <div><span class="term-cyan-text">theme</span>     - ${isEs ? "Cicla entre colores de acento cromático" : "Cycle through accent theme colors"}</div>
              <div><span class="term-cyan-text">ping</span>      - ${isEs ? "Prueba de latencia y estado (ej: ping google.com)" : "Test latency & stats (e.g. ping google.com)"}</div>
              <div><span class="term-cyan-text">cat</span>       - ${isEs ? "Gatito ASCII o lectura de archivos (ej: cat .env)" : "ASCII kitty or inspect files (e.g. cat .env)"}</div>
              <div><span class="term-cyan-text">neofetch</span>  - ${isEs ? "Información del sistema y blog" : "System and blog status summary"}</div>
              <div><span class="term-cyan-text">audio</span>     - ${isEs ? "Alterna reproducción Lo-Fi" : "Toggle Lo-Fi audio stream"}</div>
              <div><span class="term-cyan-text">whoami</span>    - ${isEs ? "Información sobre el autor y el blog" : "About author & blog info"}</div>
              <div><span class="term-cyan-text">clear</span>     - ${isEs ? "Limpia la pantalla" : "Clear terminal screen"}</div>
              <div><span class="term-cyan-text">exit</span>      - ${isEs ? "Cierra la terminal" : "Close terminal"}</div>
            </div>
          `);
          break;

        case "matrix":
          appendOutput(`<div>${isEs ? "Iniciando lluvia de código Matrix... 🕶️" : "Initiating Matrix digital rain stream... 🕶️"}</div>`, "term-res-success");
          runMatrixRain();
          break;

        case "random":
        case "roll":
          appendOutput(`<div>${isEs ? "Girando la ruleta de artículos... 🎲" : "Spinning the Post Roulette... 🎲"}</div>`, "term-res-info");
          closeTerminal();
          document.getElementById("surprise-me-trigger")?.click();
          break;

        case "quote":
        case "tip": {
          const pool = isEs ? DEV_QUOTES.es : DEV_QUOTES.en;
          const q = pool[Math.floor(Math.random() * pool.length)];
          appendOutput(`<div class="term-res-quote">${q}</div>`);
          break;
        }

        case "theme":
        case "color": {
          const currentAccent = localStorage.getItem("theme-accent") || "blue";
          const currentIdx = (ACCENTS as readonly string[]).indexOf(currentAccent);
          const nextAccent = ACCENTS[(currentIdx + 1) % ACCENTS.length] || "blue";

          localStorage.setItem("theme-accent", nextAccent);
          document.firstElementChild?.setAttribute("data-accent", nextAccent);
          soundFx.playPop(nextAccent);

          appendOutput(`<div>${isEs ? "Tema de acento cambiado a:" : "Theme accent changed to:"} <strong class="text-accent uppercase">${nextAccent}</strong> ✨</div>`, "term-res-success");
          break;
        }

        case "ping": {
          const target = args || "devosfera.vercel.app";
          const ms1 = (Math.random() * 0.35 + 0.15).toFixed(3);
          const ms2 = (Math.random() * 0.35 + 0.15).toFixed(3);
          const ms3 = (Math.random() * 0.35 + 0.15).toFixed(3);
          const avg = (((+ms1) + (+ms2) + (+ms3)) / 3).toFixed(3);
          appendOutput(`
            <div class="space-y-0.5">
              <div class="term-cyan-text">PING ${target} (127.0.0.1): 56 data bytes</div>
              <div>64 bytes from 127.0.0.1: icmp_seq=1 ttl=64 time=${ms1} ms</div>
              <div>64 bytes from 127.0.0.1: icmp_seq=2 ttl=64 time=${ms2} ms</div>
              <div>64 bytes from 127.0.0.1: icmp_seq=3 ttl=64 time=${ms3} ms</div>
              <div class="text-accent font-semibold pt-1">--- ${target} ping statistics ---</div>
              <div>3 packets transmitted, 3 packets received, 0.0% packet loss</div>
              <div class="term-green-text">round-trip min/avg/max = ${Math.min(+ms1, +ms2, +ms3).toFixed(3)}/${avg}/${Math.max(+ms1, +ms2, +ms3).toFixed(3)} ms (100% good vibes 🟢)</div>
            </div>
          `);
          break;
        }

        case "cat": {
          const target = args.toLowerCase();
          if (!target || target === "cat" || target === "kitty" || target === "miau" || target === "meow") {
            appendOutput(`
              <pre class="term-green-text font-mono leading-tight whitespace-pre">
 /\\_/\\  
( o.o )  ${isEs ? "¡Miau! La curiosidad no mató al gato, lo hizo programar." : "Meow! Curiosity didn't kill this cat, it made it code."}
 > ^ &lt;   ${isEs ? "Tip: ¡Prueba 'matrix', 'ping' o 'quote' para más diversión!" : "Tip: Try 'matrix', 'ping' or 'quote' for more fun!"}
              </pre>
            `);
          } else if (target === ".env" || target === "secrets" || target === "secret" || target === "passwords") {
            appendOutput(`<div>${isEs ? "🔐 [ACCESO DENEGADO]: Todas las variables de entorno están cifradas en la bóveda cuántica." : "🔐 [ACCESS DENIED]: All environment variables are locked in the quantum vault."}</div>`, "term-res-warn");
          } else if (target === "flag" || target === "easteregg" || target === "easter-egg") {
            appendOutput(`<div>🚩 <strong class="text-accent font-bold">FLAG&#123;y0u_f0und_th3_d3v0sf3ra_t3rm1n4l_s3cr3t&#125;</strong> — ${isEs ? "¡Felicidades, eres un hacker curioso!" : "Congrats, you are a curious hacker!"}</div>`, "term-res-success");
          } else if (target === "blog" || target === "posts" || target === "articles") {
            appendOutput(`<div>📚 ${isEs ? "¡Explora nuestros posts! Ejecuta 'random' para descubrir uno al instante." : "Explore our blog! Type 'random' to discover one instantly."}</div>`, "term-res-info");
          } else {
            appendOutput(`<div>cat: ${args}: ${isEs ? "No existe el archivo o el gato se lo comió 🐈" : "No such file or directory, or the cat ate it 🐈"}</div>`, "term-res-error");
          }
          break;
        }

        case "cowsay": {
          const msg = args || (isEs ? "¡Sigue programando con pasión!" : "Keep shipping awesome code!");
          appendOutput(`
            <pre class="term-cyan-text font-mono leading-tight whitespace-pre">
 &lt; ${msg} &gt;
        \\   ^__^
         \\  (oo)\\_______
            (__)\\       )\\/\\
                ||----w |
                ||     ||
            </pre>
          `);
          break;
        }

        case "neofetch":
        case "fastfetch": {
          const accent = localStorage.getItem("theme-accent") || "blue";
          appendOutput(`
            <div class="flex flex-col sm:flex-row items-start gap-3">
              <pre class="text-accent font-bold leading-tight font-mono text-xs">
   ____
  / __ \\___ _   __
 / / / / _ \\ | / /
/ /_/ /  __/ |/ / 
\\____/\\___/|___/  
              </pre>
              <div class="text-xs space-y-0.5 font-mono">
                <div><span class="text-accent font-bold">guest@devosfera</span></div>
                <div class="text-foreground/40">-----------------</div>
                <div><strong class="term-cyan-text">OS:</strong> Web / Astro 5.x</div>
                <div><strong class="term-cyan-text">Host:</strong> Devosfera Personal Space</div>
                <div><strong class="term-cyan-text">Uptime:</strong> 24/7 curiosity</div>
                <div><strong class="term-cyan-text">Shell:</strong> bash (devosfera-sh)</div>
                <div><strong class="term-cyan-text">Theme:</strong> ${accent.toUpperCase()}</div>
                <div><strong class="term-cyan-text">Cheat:</strong> ↑ ↑ ↓ ↓ ← → ← → B A (Arcade 80s)</div>
                <div><strong class="term-cyan-text">Stack:</strong> Tailwind + TypeScript + Pagefind</div>
              </div>
            </div>
          `);
          break;
        }

        case "audio":
        case "lofi":
        case "music": {
          const audioBtn = document.getElementById("intro-audio-btn") || document.getElementById("intro-audio-compact-btn");
          if (audioBtn) {
            audioBtn.click();
            appendOutput(`<div>${isEs ? "Reproducción de audio alternada." : "Toggled audio playback."}</div>`, "term-res-info");
          } else {
            appendOutput(`<div>${isEs ? "Reproductor no disponible en esta vista." : "Audio player not available in this view."}</div>`, "term-res-warn");
          }
          break;
        }

        case "whoami":
        case "about":
          appendOutput(`
            <div class="space-y-1">
              <div><strong class="text-accent">Andrés (0xdres)</strong> - Systems Engineer & Creative Developer 🚀</div>
              <div class="text-foreground/80">${isEs ? "Apasionado por la inteligencia artificial, desarrollo web moderno, arquitectura de software y experiencias de usuario con alta atención al detalle." : "Passionate about AI agents, modern web development, software architecture, and pixel-perfect sensory user experiences."}</div>
              <div class="text-xs text-foreground/60 pt-1">${isEs ? "Blog creado con Astro, Tailwind CSS, TypeScript y Web Audio API." : "Built with Astro, Tailwind CSS, TypeScript, and Web Audio API."}</div>
            </div>
          `, "term-res-info");
          break;


        case "clear":
        case "cls":
          clearOutput();
          break;

        case "exit":
        case "close":
        case "quit":
          closeTerminal();
          break;

        case "sudo":
          appendOutput(`<div>${isEs ? "¡Buen intento! Ya tienes superpoderes de root en este blog. 😎" : "Nice try! You already have full root superpowers in this blog. 😎"}</div>`, "term-res-warn");
          break;

        default:
          appendOutput(`<div>${isEs ? "Comando no reconocido. Escribe 'help' para ver la lista." : "Command not found. Type 'help' for available commands."}</div>`, "term-res-error");
          break;
      }
    }

    // Event Listeners
    trigger.addEventListener("click", openTerminal);
    backdrop?.addEventListener("click", closeTerminal);
    closeBtn?.addEventListener("click", closeTerminal);
    clearBtn?.addEventListener("click", clearOutput);

    chips.forEach(chip => {
      chip.addEventListener("click", () => {
        const cmd = chip.dataset.cmd;
        if (cmd) {
          if (input) input.value = cmd;
          executeCommand(cmd);
          input.value = "";
        }
      });
    });

    input.addEventListener("input", () => {
      soundFx.playKeyClick();
    });

    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (commandHistory.length > 0) {
          historyIndex = Math.min(historyIndex + 1, commandHistory.length - 1);
          input.value = commandHistory[historyIndex] || "";
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = commandHistory[historyIndex] || "";
        } else {
          historyIndex = -1;
          input.value = "";
        }
      }
    });

    form?.addEventListener("submit", (e: Event) => {
      e.preventDefault();
      const val = input.value;
      input.value = "";
      executeCommand(val);
    });

    /**
     * Global keyboard shortcut listener for opening the shell terminal.
     * Rules:
     * 1. 'Escape' closes the modal if it is active.
     * 2. Key 'c' or 'C' opens the terminal ONLY on the homepage (avoids interfering with other pages).
     * 3. Ignores modifier keys (Cmd, Ctrl, Alt, Shift) to prevent conflicts with browser/OS shortcuts.
     * 4. Ignores keypresses while typing inside editable inputs, textareas, or other active modals.
     */
    const onKeyDownGlobal = (e: KeyboardEvent) => {
      // If modal is open, ESC closes it
      if (!modal.classList.contains("hidden")) {
        if (e.key === "Escape") {
          closeTerminal();
        }
        return;
      }

      // Check that we are strictly on the home page
      const isHome =
        document.querySelector('[data-layout="index"]') !== null ||
        window.location.pathname === "/" ||
        window.location.pathname === "/es" ||
        window.location.pathname === "/es/";
      if (!isHome) return;

      // Ignore modifier keys to not hijack browser / OS shortcuts
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      if (e.repeat) return;

      // Ignore if user is currently typing in an input, textarea, select or contenteditable
      const target = e.target as HTMLElement | null;
      const activeTag = document.activeElement?.tagName;
      const isEditable =
        document.activeElement?.hasAttribute("contenteditable") ||
        activeTag === "INPUT" ||
        activeTag === "TEXTAREA" ||
        activeTag === "SELECT" ||
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.tagName === "SELECT";
      if (isEditable) return;

      // Ignore if any other modal is active (search, shortcuts, roulette)
      const isSearchActive = document.getElementById("search-modal")?.classList.contains("active");
      const isShortcutsActive = document.getElementById("shortcuts-modal")?.classList.contains("active");
      const isRouletteActive = !document.getElementById("surprise-roulette-modal")?.classList.contains("hidden");
      if (isSearchActive || isShortcutsActive || isRouletteActive) return;

      // Open terminal when 'c' or 'C' is pressed
      if (e.key === "c" || e.key === "C") {
        e.preventDefault();
        openTerminal();
      }
    };

    window.addEventListener("keydown", onKeyDownGlobal);

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("keydown", onKeyDownGlobal);
      if (matrixAnimationId) cancelAnimationFrame(matrixAnimationId);
      if (matrixTimeoutId) clearTimeout(matrixTimeoutId);
    }, { once: true });
  }

  // Run on initial load and View Transitions
  initHeroTerminal();
  document.addEventListener("astro:page-load", initHeroTerminal);
</script>
