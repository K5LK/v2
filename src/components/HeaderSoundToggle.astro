---
/**
 * HeaderSoundToggle.astro
 *
 * Dedicated subcomponent for desktop header settings popover Sound Effects toggle.
 * Retains single tactile Mute/Unmute state without complex audio profiles.
 */
import { useTranslations } from "@/i18n/utils";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<div class="popover-row popover-row--sound">
  <div class="popover-row-label">
    <svg
      class="size-3.5 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
      <path class="sound-wave-icon" d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"></path>
    </svg>
    {t("nav.soundFx")}
  </div>
  <button
    id="sound-fx-btn"
    type="button"
    class="sound-toggle-pill"
    title={t("nav.soundFxToggle")}
    aria-label={t("nav.soundFxToggle")}
    data-label-on={t("nav.soundFxOn")}
    data-label-off={t("nav.soundFxOff")}
  >
    <span id="sound-fx-text" class="sound-pill-text">{t("nav.soundFxOn")}</span>
  </button>
</div>
