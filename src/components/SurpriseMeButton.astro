---
/**
 * SurpriseMeButton.astro (Option A - Discovery Card Modal)
 *
 * An interactive "Surprise Me" button that selects a random blog post.
 * Features:
 * - Clean, lightweight modal dialog with responsive layout
 * - Snappy ~450ms CSS title-shuffle animation with mechanical tick audio feedback
 * - Reveals a discovery card with tag, reading time, excerpt, and instant navigation
 * - Full accessibility with keyboard escape, focus management, and localized strings
 * - Zero heavy 3D drum physics or canvas confetti loops for optimal performance
 */
import { useTranslations } from "@/i18n/utils";
import "@/styles/surprise-me.css";

export interface RandomPostItem {
  title: string;
  href: string;
  tag?: string;
  readingTime?: string;
  description?: string;
}

interface Props {
  posts: RandomPostItem[];
  class?: string;
}

const { posts, class: className = "" } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

// Serialize posts safely for the client-side JavaScript engine
const postsJson = JSON.stringify(posts);
---

<div class:list={["surprise-me-container inline-block", className]}>
  <!-- Trigger Button -->
  <button
    id="surprise-me-trigger"
    type="button"
    class="surprise-me-btn group relative inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1.5 font-sans text-xs font-medium text-accent transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-accent/20 hover:shadow-lg hover:shadow-accent/20 active:scale-95 sm:text-sm cursor-pointer"
    title={t("index.surpriseMeHint")}
    aria-label={t("index.surpriseMeHint")}
    data-posts={postsJson}
  >
    <!-- Glowing pulse aura -->
    <span
      class="pointer-events-none absolute -inset-0.5 -z-10 rounded-full bg-linear-to-r from-accent/20 to-accent/5 opacity-0 blur-xs transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"></span>

    <!-- Animated Dice Icon -->
    <span class="dice-icon-wrap flex shrink-0 items-center justify-center text-accent">
      <svg
        class="dice-svg size-4 transition-transform duration-500 group-hover:rotate-180"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="18" x="3" y="3" rx="4" ry="4"></rect>
        <circle cx="8" cy="8" r="1.2" fill="currentColor"></circle>
        <circle cx="16" cy="8" r="1.2" fill="currentColor"></circle>
        <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
        <circle cx="8" cy="16" r="1.2" fill="currentColor"></circle>
        <circle cx="16" cy="16" r="1.2" fill="currentColor"></circle>
      </svg>
    </span>

    <span class="font-semibold tracking-tight">{t("index.surpriseMe")}</span>

    <!-- Sparkle indicator -->
    <span
      class="text-accent/60 transition-transform duration-300 group-hover:scale-125 group-hover:text-accent"
      aria-hidden="true"
    >
      ✨
    </span>
  </button>

  <!-- Discovery Card Modal Dialog -->
  <div
    id="surprise-roulette-modal"
    class="roulette-modal-overlay fixed inset-0 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="roulette-modal-title"
  >
    <!-- Modal Backdrop Blur -->
    <div
      id="roulette-backdrop"
      class="roulette-backdrop absolute inset-0 bg-background/80 backdrop-blur-md transition-opacity duration-300"
      aria-hidden="true"
    >
    </div>

    <!-- Modal Card Container -->
    <div
      id="roulette-card"
      class="roulette-card relative z-10 w-full max-w-lg overflow-hidden rounded-2xl border border-border/40 bg-background/95 p-6 shadow-2xl backdrop-blur-xl transition-all duration-300 sm:p-7"
    >
      <!-- Background Ambient Glow -->
      <div
        class="pointer-events-none absolute -top-24 -left-24 size-48 rounded-full bg-accent/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-24 -bottom-24 size-48 rounded-full bg-accent/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <!-- Header -->
      <div class="relative z-20 flex items-center justify-between border-b border-border/30 pb-4">
        <div class="flex items-center gap-3">
          <span
            class="flex size-9 items-center justify-center rounded-xl bg-accent/15 text-accent shadow-sm ring-1 shadow-accent/20 ring-accent/30"
          >
            <svg
              id="modal-dice-icon"
              class="size-5 transition-transform duration-700"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="3" rx="4" ry="4"></rect>
              <circle cx="8" cy="8" r="1.2" fill="currentColor"></circle>
              <circle cx="16" cy="8" r="1.2" fill="currentColor"></circle>
              <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
              <circle cx="8" cy="16" r="1.2" fill="currentColor"></circle>
              <circle cx="16" cy="16" r="1.2" fill="currentColor"></circle>
            </svg>
          </span>
          <div>
            <h2
              id="roulette-modal-title"
              class="text-base font-bold tracking-tight text-foreground sm:text-lg"
            >
              {t("index.rouletteTitle")}
            </h2>
            <p id="roulette-status-text" class="text-xs text-foreground/60">
              {t("index.rouletteSubtitle")}
            </p>
          </div>
        </div>

        <!-- Close Button -->
        <button
          id="roulette-close-btn"
          type="button"
          class="flex size-8 items-center justify-center rounded-lg border border-border/30 bg-muted/15 text-foreground/70 transition-colors hover:border-accent/40 hover:bg-accent/10 hover:text-accent focus-visible:outline-accent cursor-pointer"
          aria-label={t("index.closeRoulette")}
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Discovery Stage Area -->
      <div class="relative z-20 my-5">
        <!-- 1. Shuffling Mode State -->
        <div
          id="roulette-shuffle-view"
          class="shuffle-stage rounded-xl border border-accent/25 bg-muted/15 p-6 shadow-inner"
        >
          <div class="flex items-center gap-2 mb-2 text-xs font-semibold uppercase tracking-wider text-accent/80">
            <span class="size-2 rounded-full bg-accent animate-ping"></span>
            <span>{locale === "es" ? "Barajando publicaciones..." : "Shuffling articles..."}</span>
          </div>
          <div id="shuffle-title" class="shuffle-title-text line-clamp-2">
            ...
          </div>
        </div>

        <!-- 2. Discovery Winner Card (Revealed after snappy shuffle) -->
        <div
          id="roulette-winner-card"
          class="roulette-winner-card hidden rounded-xl border border-accent/40 bg-accent/5 p-5 shadow-lg shadow-accent/10 transition-all duration-300"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="winner-tag"
              class="inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-xs font-semibold text-accent"
            >
              #dev
            </span>
            <span
              id="winner-time"
              class="flex items-center gap-1 text-xs text-foreground/60"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span id="winner-time-val">5 min</span>
            </span>
          </div>

          <h3
            id="winner-title"
            class="mt-2.5 text-left text-lg leading-snug font-bold text-foreground transition-colors hover:text-accent"
          >
            Post Title
          </h3>

          <p
            id="winner-desc"
            class="mt-1.5 line-clamp-2 text-left text-xs leading-relaxed text-foreground/75"
          >
            Description of the winning article
          </p>

          <!-- Actions -->
          <div
            class="mt-5 flex flex-col items-stretch gap-2.5 sm:flex-row sm:items-center"
          >
            <a
              id="winner-read-btn"
              href="#"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-background shadow-md shadow-accent/30 transition-all duration-200 hover:-translate-y-0.5 hover:opacity-90 hover:shadow-lg hover:shadow-accent/40 cursor-pointer"
            >
              <span>{t("index.readNow")}</span>
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <button
              id="winner-respin-btn"
              type="button"
              class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border/40 bg-muted/20 px-4 py-2.5 text-sm font-medium text-foreground transition-all duration-200 hover:border-accent/40 hover:bg-accent/10 hover:text-accent cursor-pointer"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
              <span>{t("index.spinAgain")}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initSurpriseRoulette } from "@/scripts/surprise-me";

  initSurpriseRoulette();
  document.addEventListener("astro:page-load", initSurpriseRoulette);
</script>
